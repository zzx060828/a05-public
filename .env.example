# Frontend API gateway URL, for example http://127.0.0.1:8001
VITE_API_BASE_URL=

# Browser-side avatar application key. Restrict it by domain in the provider console.
VITE_AVATAR_API_KEY=
# Compatibility only: VITE_ values are bundled into browser code. Do not use a
# long-lived provider secret here; prefer a backend-issued temporary credential.
VITE_AVATAR_API_SECRET=

# Server-side model provider credentials. Never expose these with a VITE_ prefix.
ZHIPUAI_API_KEY=
DEEPSEEK_API_KEY=
JWT_SECRET_KEY=

# Alibaba Cloud speech recognition credentials
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_ASR_APP_KEY=
ALIYUN_REGION_ID=cn-shanghai
